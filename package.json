{
  "name": "thirsty-autobook-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "chrome": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-onda-chrome.ps1",
    "inspect": "tsx src/index.ts inspect",
    "practice": "tsx src/index.ts practice",
    "release:observe": "tsx src/index.ts release:observe",
    "release:preopen-check": "tsx src/index.ts release:preopen-check",
    "release:reload-profile": "tsx src/index.ts release:reload-profile",
    "availability:compare": "tsx src/index.ts availability:compare",
    "race:dry": "tsx src/index.ts race:dry",
    "selection:armed": "tsx src/index.ts selection:armed",
    "handoff:test": "tsx src/index.ts handoff:test",
    "race": "tsx src/index.ts race",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ui": "npm run ui:build && node scripts/run-ui.mjs",
    "exe:build": "npm run ui:build && node scripts/build-exe.mjs",
    "ui:build": "tsc -p tsconfig.ui.json && node scripts/build-ui.mjs",
    "availability:dry": "tsx src/index.ts availability:dry",
    "api:preview": "tsx src/api-booking/preview-config.ts",
    "api:prewarm": "tsx src/api-booking/prewarmed-runner.ts",
    "release:readiness": "tsx src/readiness-cli.ts",
    "chrome:b": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-onda-chrome.ps1 -Worker B",
    "chrome:dual": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-onda-dual.ps1",
    "dual:readiness": "tsx src/dual-entry.ts readiness",
    "dual:prepare": "tsx src/dual-entry.ts readiness",
    "dual:practice:dry": "tsx src/dual-entry.ts dry",
    "dual:practice:selection": "tsx src/dual-entry.ts practice",
    "dual:practice:full": "tsx src/dual-entry.ts full",
    "dual:race:dry": "tsx src/dual-entry.ts race:dry"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "5.2.0",
    "dotenv": "^17.4.2",
    "luxon": "^3.7.2",
    "playwright": "^1.63.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.20.2",
    "electron": "^44.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
